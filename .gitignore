# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# local data (sqlite db, encryption key)
/data/

# demo household (made-up data, safe to delete)
/demo-data/

# claude code config + session artifacts (per-developer, not shared)
/.claude/
/.superpowers/

# menu bar app build outputs
/menubar/.build/
/menubar/build/
/menubar/.swiftpm/
/menubar/Package.resolved

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.superpowers/

# desktop installer output
/dist-desktop/

# e2e
/e2e/.data/
/test-results/
/playwright-report/

# local Playwright MCP output
/.playwright-mcp/

# local QA and agent scratch output (screenshots, sweep scripts)
/.qa-ui/
/.std/

# Docker statement drop folder
/imports/
